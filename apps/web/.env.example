# ---------------------------------------------------------------
# OppRadar hosted web app (apps/web). Copy to apps/web/.env.local
# ---------------------------------------------------------------

# Postgres (Neon/Supabase/Docker). Leave empty to use embedded PGlite in apps/web/.pglite
DATABASE_URL=

# Auth.js: `openssl rand -base64 32`
AUTH_SECRET=
RADAR_PUBLIC_URL=http://localhost:3000

# Email: console (dev, prints magic links) or resend (production)
RADAR_EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="OppRadar <radar@yourdomain.com>"
RADAR_PHYSICAL_ADDRESS="OppRadar, 123 Example Street, Bengaluru 560001, India"

# Signs unsubscribe / feedback links: `openssl rand -hex 32`
RADAR_LINK_SECRET=

# Protects /api/cron/*: `openssl rand -hex 32` (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Comma-separated emails with access to /admin
ADMIN_EMAILS=

# LLM (optional; rules mode without it)
ANTHROPIC_API_KEY=
RADAR_MODEL=claude-haiku-5-5
LLM_DAILY_TOKEN_BUDGET=400000
RADAR_CONTACT_EMAIL=

# Use recorded fixtures instead of live sources (demos, CI)
RADAR_FIXTURES=0

# Billing (off = everyone gets Pro, pricing CTA becomes "Join Pro waitlist")
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

NEXT_PUBLIC_GITHUB_REPO=rajnandanijain1401-code/opp-radar
