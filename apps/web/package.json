{
  "name": "@opp-radar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:setup && next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts --if-empty"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.16",
    "@opp-radar/core": "workspace:^",
    "@opp-radar/emails": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "15.5.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4"
  }
}
