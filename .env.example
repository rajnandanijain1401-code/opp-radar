# ---------------------------------------------------------------
# OppRadar CLI / OSS mode (GitHub Actions or local `pnpm radar`)
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# LLM (optional). Without a key, OppRadar runs in free rules mode.
ANTHROPIC_API_KEY=
RADAR_MODEL=claude-haiku-5-5
LLM_DAILY_TOKEN_BUDGET=400000

# Email provider: smtp | resend | console
RADAR_EMAIL_PROVIDER=console
RADAR_FROM_EMAIL="OppRadar <radar@example.com>"

# SMTP (Gmail: smtp.gmail.com / 465 / your address / a 16-char App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend (hosted mode)
RESEND_API_KEY=

# Contact email used in the User-Agent for SEC EDGAR and other polite fetches
RADAR_CONTACT_EMAIL=you@example.com

# Use recorded fixtures instead of the live network (great for demos and CI)
RADAR_FIXTURES=0

# Secret used to sign unsubscribe / feedback links (any long random string)
RADAR_LINK_SECRET=change-me-to-a-long-random-string
RADAR_PUBLIC_URL=http://localhost:3000
RADAR_PHYSICAL_ADDRESS="OppRadar, 123 Example Street, Bengaluru 560001, India"
LOG_LEVEL=info
